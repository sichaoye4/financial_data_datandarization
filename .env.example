# Browser/API ports
API_PORT=8000
WEB_PORT=5173
VITE_API_BASE_URL=/api

# Backend-only DeepSeek configuration. These defaults match Football Legend.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=enabled
DEEPSEEK_MAX_TOKENS=4096

# Optional SQLite location (default: backend/runtime/workbench.db)
# WORKBENCH_DB_PATH=C:\absolute\path\to\workbench.db

# Local Python development:
# DEEPSEEK_API_KEY_FILE=C:\absolute\path\to\llm_key.txt
#
# Docker Compose:
DEEPSEEK_API_KEY_FILE_HOST=./llm_key.txt

# Never put the credential value in this file or in a VITE_* variable.
